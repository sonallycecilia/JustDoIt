# Acrescente estas variáveis ao /opt/justdoit/.env no servidor.
# Gere o segredo com pelo menos 32 bytes aleatórios e não reutilize o JWT_SECRET.
EXPORT_DOWNLOAD_SECRET=replace-with-a-long-random-secret
PUBLIC_TASK_API_URL=https://justdoitapi.duckdns.org

# Limites seguros para uma instância pequena; ajuste após observar o dashboard.
EXPORT_STORAGE_PATH=/var/lib/justdoit/exports
EXPORT_PAGE_SIZE=200
EXPORT_MAX_CONCURRENCY=2
EXPORT_QUEUE_CAPACITY=8
EXPORT_MAX_ACTIVE_PER_USER=1
EXPORT_MAX_RECORDS=1000000
EXPORT_MAX_FILE_SIZE_BYTES=536870912
EXPORT_MAX_DURATION=30m
EXPORT_DOWNLOAD_TTL=15m
